PORT="8000"
APP_ENV="development"
APP_NAME=""
PW_DEFAULT_ADMIN=""
FORMAT_DATETIME="2006-01-02 15:04:05"
USER_MAX_DEVICE="1"

# Connection DB Postgres
DB_PG_HOST=""
DB_PG_PORT="5432"
DB_PG_USERNAME="postgres"
DB_PG_PASSWORD=""
DB_PG_NAME="postgres"
DB_PG_SSLMODE="disable"
DB_PG_SCHEMA="public"

# JWT
JWT_SECRET_KEY=""
JWT_RERESH_TOKEN_SECRET_KEY=
JWT_EXPIRED_HOURS="1"
JWT_REFRESH_TOKEN_EXPIRED_DAYS="7"

# OpenTelemetry (SigNoz OTLP gRPC endpoint)
OTEL_ENABLED="true"
OTEL_EXPORTER_OTLP_ENDPOINT="localhost:4317"
OTEL_EXPORTER_OTLP_INSECURE="true"
OTEL_SAMPLER_RATIO="1.0"
